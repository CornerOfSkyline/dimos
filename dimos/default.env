OPENAI_API_KEY=
HUGGINGFACE_ACCESS_TOKEN=
ALIBABA_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=
# Hugging Face endpoint: a mirror (e.g. https://hf-mirror.com) or empty for
# the default https://huggingface.co. Read before huggingface_hub/transformers
# import; also settable per run with --hf-endpoint.
HUGGINGFACE_PRV_ENDPOINT=
HF_ENDPOINT=https://hf-mirror.com
# Remote Ollama server for ollama: agent models (e.g. http://192.168.1.50:11434);
# empty = local Ollama. Also settable per run with --ollama-base-url.
OLLAMA_BASE_URL=
ROBOT_IP=

# Hosted teleop — transport blueprints (teleop-hosted-go2-transport / -multicam).
TRANSPORTS__BROKER__API_KEY=
TRANSPORTS__BROKER__ROBOT_NAME=
WEBRTC_SERVER_HOST=0.0.0.0
WEBRTC_SERVER_PORT=9991
DISPLAY=:0

# Optional
#DIMOS_MAX_WORKERS=
TEST_RTSP_URL=

# Module settings (uncomment as needed; module names precede double underscores).
#GO2CONNECTION__AES_128_KEY=
#GO2CONNECTION__MUJOCO__STEPS_PER_FRAME=7
#MCPSERVER__PORT=9990
#RERUNBRIDGEMODULE__RERUN_OPEN=none
#RELAYBRIDGEMODULE__RELAY_KEY=
#TYPESAFENAVIGATIONAGENT__API_KEY=
#DIMOS_CLOUD_API_KEY=
#DIMOS_CLOUD_UPLOAD_CODEC=lz4
